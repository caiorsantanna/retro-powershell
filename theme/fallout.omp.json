{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "#8FFFB5",
          "options": {
            "style": "full"
          },
          "style": "plain",
          "template": "{{ .Path }}",
          "type": "path"
        },
        {
          "foreground": "#4DFF88",
          "style": "plain",
          "template": " - {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Staging.Changed) (.Working.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}",
          "type": "git"
        },
        {
          "foreground": "#FFC95C",
          "options": {
            "always_enabled": true,
            "style": "austin",
            "threshold": 500
          },
          "style": "plain",
          "template": " - {{ .FormattedMs }}",
          "type": "executiontime"
        },
        {
          "foreground": "#FFC95C",
          "style": "plain",
          "template": " - ADMIN",
          "type": "root"
        },
        {
          "foreground": "#FF8A73",
          "style": "plain",
          "template": "{{ if gt .Code 0 }} - ERR {{ reason .Code }}{{ end }}",
          "type": "status"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "foreground": "#4DFF88",
          "style": "plain",
          "template": "{{ if .SSHSession }}REMOTE - {{ end }}<#8FFFB5>{{ .UserName }}@{{ .HostName }}</>",
          "type": "session"
        },
        {
          "foreground": "#FFC95C",
          "options": {
            "time_format": "15:04:05"
          },
          "style": "plain",
          "template": " - {{ .CurrentDate | date .Format }}",
          "type": "time"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#4DFF88",
          "style": "plain",
          "template": ">",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4
}
